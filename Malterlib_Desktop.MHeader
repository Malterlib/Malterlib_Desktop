Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Desktop}"
{
	Compile
	{
		!!CompileDialect "C"

		SearchPath += [`@(MalterlibSysRoot)/usr/include/dbus-1.0`, `@(MalterlibSysRoot)/usr/lib/dbus-1.0/include`]
		{
			!!PlatformFamily "Linux"
		}
	}

	%Group "Desktop"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Desktop/^*"
		}
		%File "Source/*"
		%Group "Platform"
		{
			%File "Source/Platform/*"
			{
				Compile.Disabled true
				{
					!PlatformFamily PlatformFamilyFromImpFile
				}
			}
		}
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Desktop: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Desktop"
	{
		!!MalterlibLibrary_Desktop true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Desktop: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Desktop true
	}
}

%Group "{Test}/{Malterlib_Desktop}"
{
	Compile
	{
		!!CompileDialect "C"

		SearchPath += [`@(MalterlibSysRoot)/usr/include/dbus-1.0`, `@(MalterlibSysRoot)/usr/lib/dbus-1.0/include`]
		{
			!!PlatformFamily "Linux"
		}
	}

	%Group "Tests"
	{
		%File "Test/*"
		%File "Test/Test_Malterlib_Desktop_DBus.cpp"
		{
			Compile.Disabled true
			{
				!PlatformFamily "Linux"
			}
		}
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Desktop"
	MalterlibTestExtraGroups_Malterlib_Desktop: [string] = ["{Test}/{Malterlib_Desktop}"]
}

